---
# https://kubernetes.io/docs/reference/kubectl/kuberc/
apiVersion: kubectl.config.k8s.io/v1beta1
kind: Preference
# -------------------------------------------------
# Define custom shortcuts for kubectl commands
# -------------------------------------------------
aliases:
- name: logsw
  command: logs
  options:
  - name: all-pods
    default: "true"
  - name: all-containers
    default: "true"
  - name: max-log-requests
    default: "200"
  - name: ignore-errors
    default: "true"
  - name: follow
    default: "true"
  - name: since
    default: 24h
- name: runx
  command: run
  options:
  - name: stdin
    default: "true"
  - name: tty
    default: "true"
  - name: rm
    default: "true"
  - name: image
    default: busybox:stable
  appendArgs:
  - shell
  - bash
- name: execx
  command: exec
  options:
  - name: tty
    default: "true"
  - name: stdin
    default: "true"
  appendArgs:
  - --
  - bash
- name: gpo  # get pods ordered by age
  command: get
  prependArgs:
  - pods
  options:
  - name: sort-by
    default: .metadata.creationTimestamp
- name: kctx  # context switcher
  command: config
  prependArgs:
    - use-context
# -------------------------------------------------
# Default values for command line arguments
# -------------------------------------------------
defaults:
- command: apply
  options:
  - name: server-side
    default: "true"
- command: delete
  options:
  - name: interactive
    default: "true"
- command: diff
    options:
    - name: server-side
      default: 'true'
  - command: drain
    options:
    - name: delete-emptydir-data
      default: 'true'
    - name: ignore-daemonsets
      default: 'true'
  - command: exec
    options:
    - name: stdin
      default: 'true'
    - name: tty
      default: 'true'
credentialPluginPolicy: DenyAll
