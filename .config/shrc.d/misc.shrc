# For GnuPG
export GPG_TTY=$(tty)
# gpg-connect-agent reloadagent /bye

_SSH_AGENT_ENV="${HOME}/.ssh/agent.env"

_ssh_agent_running() {
  [ -n "${SSH_AGENT_PID}" ] && kill -0 "${SSH_AGENT_PID}" 2>/dev/null \
    && [ -S "${SSH_AUTH_SOCK}" ]
}

_ssh_agent_start() {
  ssh-agent | sed 's/^echo/#echo/' > "${_SSH_AGENT_ENV}"
  chmod 600 "${_SSH_AGENT_ENV}"
  . "${_SSH_AGENT_ENV}"
  ssh-add 2>/dev/null
}

if [ -f "${_SSH_AGENT_ENV}" ]; then
  . "${_SSH_AGENT_ENV}" >/dev/null
  if ! _ssh_agent_running; then
    echo "Stale ssh-agent. Spawning new..."
    _ssh_agent_start
  fi
else
  echo "Starting ssh-agent..."
  _ssh_agent_start
fi

