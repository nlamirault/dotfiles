{
    "terminal.integrated.env.osx": {
        "CW_NEW_SESSION": "1",
        "Q_NEW_SESSION": "1"
    },
    "workbench.editor.enablePreview": false,
    "workbench.iconTheme": "material-icon-theme",
    "editor.fontLigatures": true,
    "editor.minimap.enabled": false,
    "files.associations": {
        "*.mk": "makefile",
        "_helpers.tpl": "jinja",
        "**/defaults/**/*.yml": "jinja-yaml",
        "**/group_vars/**/*": "jinja-yaml",
        "**/host_vars/**/*": "jinja-yaml",
        "**/vars/**/*.yml": "jinja-yaml",
        "**/tasks/**/*.yml": "ansible",
        "**/handlers/*.yml": "ansible",
        "**/meta/*.yml": "ansible",
        "**/roles/**/*.yml": "ansible",
        "**/playbooks/**/*.yml": "ansible",
        "**/ansible/**/hosts": "ini",
        "**/ansible/**/inventory": "ini",
        "*.yaml": "yaml",
        "ansible.cfg": "ini",
        "*.hcl": "terraform",
        "*.yml": "yaml"
    },
    "[makefile]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": false
    },
    "[yaml]": {
        "editor.formatOnSave": false,
    },
    "editor.fontFamily": "'Monaspace Neon', monospace",
    "editor.formatOnType": true,
    "editor.defaultFormatter": "dprint.dprint",
    "editor.formatOnSave": true,
    "workbench.colorTheme": "Visual Studio Dark",
    "lldb.library": "/Library/Developer/CommandLineTools/Library/PrivateFrameworks/LLDB.framework/Versions/A/LLDB",
    "lldb.launch.expressions": "native",
    "D2.previewLayout": "dagre",
    "editor.accessibilitySupport": "off",
}