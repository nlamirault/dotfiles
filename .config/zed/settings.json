{
  "icon_theme": "Material Icon Theme",
  // "icon_theme": "VSCode Great Icons Theme",
  "auto_update_extensions": {
    "vscode-great-icons": false,
    "helm": false,
  },
  "tab_size": 2,
  "format_on_save": "on",
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "GitHub Dark",
  },
  "base_keymap": "VSCode",
  "ui_font_size": 15,
  "buffer_font_size": 12,
  // Indentation, rainbow indentation
  "indent_guides": {
    "enabled": true,
    "coloring": "indent_aware",
  },
  "inlay_hints": {
    "enabled": true,
    "show_type_hints": true,
    "show_parameter_hints": true,
    "show_other_hints": true,
    "edit_debounce_ms": 700,
    "scroll_debounce_ms": 50,
  },
  "file_types": {
    "Dockerfile": ["Dockerfile", "Dockerfile.*"],
    "JSON": ["json", "jsonc", "*.code-snippets"],
    // "Helm": [
    //   "**/templates/**/*.tpl",
    //   "**/templates/**/*.yaml",
    //   "**/templates/**/*.yml",
    //   "**/helmfile.d/**/*.yaml",
    //   "**/helmfile.d/**/*.yml",
    //   "**/values*.yaml"
    // ]
  },
  "git": {
    "git_gutter": "tracked_files",
    "inline_blame": {
      "enabled": true,
    },
  },
  "git_panel": {
    "dock": "right",
  },
  "language_models": {
    "ollama": {
      "api_url": "http://localhost:11434",
    },
  },
  "languages": {
    "Go": {
      "code_actions_on_format": {
        "source.organizeImports": true,
      },
    },
    "JSON": {
      "tab_size": 2,
      "prettier": {
        "allowed": true,
      },
    },
    "Markdown": {
      "format_on_save": "on",
      "use_on_type_format": false,
      "prettier": {
        "allowed": true,
      },
      "remove_trailing_whitespace_on_save": true,
    },
    "Python": {
      "formatter": [
        {
          "language_server": {
            "name": "ruff",
          },
        },
      ],
      "language_servers": ["ruff"],
      "tab_size": 4,
    },
    "Rust": {
      "formatter": "language_server",
      "format_on_save": "on",
    },
    "YAML": {
      "format_on_save": "off",
      "prettier": {
        "allowed": true,
      },
    },
  },
  "lsp": {
    "helm_ls": {
      "settings": {
        "helm-ls": {
          "logLevel": "info",
          "yamlls": {
            "enabled": true,
          },
        },
      },
    },
    "pyright": {
      "settings": {
        "python.analysis": {
          "diagnosticMode": "workspace",
          "typeCheckingMode": "strict",
        },
        "python": {
          "pythonPath": ".venv/bin/python",
        },
      },
    },
    "ruff": {
      "initialization_options": {
        "settings": {
          "lineLength": 100,
          "lint": {
            "extendSelect": ["I"],
          },
        },
      },
    },
    "rust-analyzer": {
      "initialization_options": {
        "rust": {
          "analyzerTargetDir": true,
        },
      },
    },
    "terraform-ls": {
      "initialization_options": {
        "experimentalFeatures": {
          "prefillRequiredFields": true,
        },
      },
    },
    "yaml-language-server": {
      "settings": {
        "yaml": {
          "keyOrdering": true,
          "format": {
            "singleQuote": true,
          },
        },
      },
    },
  },
  "preview_tabs": {
    "enabled": false,
    "enable_preview_from_file_finder": false,
  },
  "outline_panel": {
    "button": true,
    "default_width": 240,
    "dock": "left",
    "file_icons": true,
    "folder_icons": true,
    "git_status": true,
    "indent_size": 20,
    "auto_reveal_entries": true,
    "auto_fold_dirs": true,
  },
  "project_panel": {
    "button": true,
    "default_width": 240,
    "dock": "left",
    "file_icons": true,
    "folder_icons": true,
    "git_status": true,
    "indent_size": 10,
    "auto_reveal_entries": true,
    "auto_fold_dirs": true,
    "scrollbar": {
      "show": "always",
    },
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "notification_panel": {
    "dock": "left",
  },
  "scrollbar": {
    "show": "auto",
    "cursors": true,
    "git_diff": true,
    "search_results": true,
    "selected_symbol": true,
    "diagnostics": "all",
  },
  "tab_bar": {
    "show": true,
    "show_nav_history_buttons": true,
  },
  "tabs": {
    "close_position": "right",
    "file_icons": true,
    "git_status": false,
  },
  "toolbar": {
    "breadcrumbs": true,
    "quick_actions": true,
  },
  "wrap_guides": [80, 120],
  "show_wrap_guides": true,
  // Turn off telemetry
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "context_servers": {
    "awslabs.aws-api-mcp-server": {
      "command": "uvx",
      "args": ["awslabs.aws-api-mcp-server@latest"],
      "env": {
        "AWS_REGION": "eu-west-1",
        "FASTMCP_LOG_LEVEL": "INFO",
      },
    },
    "awslabs.core-mcp-server": {
      "command": "uvx",
      "args": ["awslabs.core-mcp-server@latest"],
      "env": {
        "FASTMCP_LOG_LEVEL": "INFO",
      },
    },
    "awslabs.aws-documentation-mcp-server": {
      "command": "uvx",
      "args": ["awslabs.aws-documentation-mcp-server@latest"],
      "env": {
        "FASTMCP_LOG_LEVEL": "INFO",
      },
    },
    "awslabs.ecs-mcp-server": {
      "command": "uvx",
      "args": ["--from", "awslabs-ecs-mcp-server", "ecs-mcp-server"],
      "env": {
        "AWS_REGION": "eu-west-1",
        "FASTMCP_LOG_LEVEL": "ERROR",
        "ALLOW_WRITE": "false",
        "ALLOW_SENSITIVE_DATA": "false",
      },
    },
    "awslabs.iam-mcp-server": {
      "command": "uvx",
      "args": ["awslabs.iam-mcp-server@latest", "--readonly"],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR",
      },
    },
    "aws-knowledge-mcp-server": {
      "enabled": true,
      "settings": {},

      "url": "https://knowledge-mcp.global.api.aws",
    },
    "awslabs.aws-pricing-mcp-server": {
      "command": "uvx",
      "args": ["awslabs.aws-pricing-mcp-server@latest"],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR",
      },
    },
    "kubernetes-mcp-server": {
      "command": "npx",
      "args": ["-y", "kubernetes-mcp-server@latest", "--read-only"],
    },
    "kubernetes": {
      "command": "npx",
      "args": ["mcp-server-kubernetes"],
    },
    "terraform": {
      "command": "docker",
      "args": ["run", "-i", "--rm", "hashicorp/terraform-mcp-server"],
    },
  },
}
