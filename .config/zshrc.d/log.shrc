reset_color="\\e[0m"
color_red="\\e[31m"
color_green="\\e[32m"
color_blue="\\e[36m"
color_yellow="\\e[33m"

# Define log levels
LOG_LEVEL_ERROR=0
LOG_LEVEL_WARN=1
LOG_LEVEL_INFO=2
LOG_LEVEL_DEBUG=3
LOG_LEVEL_TRACE=4

# Set default log level (can be overridden by env or arg)
LOG_LEVEL="${LOG_LEVEL:=$LOG_LEVEL_INFO}"

# Logging functions with level checks
log_trace() {
  [[ ${LOG_LEVEL_TRACE} -le ${LOG_LEVEL} ]] && echo -e "${COLOR_YELLOW}🟡 $*${RESET_COLOR}" >&2
}

log_debug() {
  [[ ${LOG_LEVEL_DEBUG} -le ${LOG_LEVEL} ]] && echo -e "${COLOR_BLUE}🔵 $*${RESET_COLOR}" >&2
}

log_info() {
  [[ ${LOG_LEVEL_INFO} -le ${LOG_LEVEL} ]] && echo -e "${COLOR_GREEN}🟢 $*${RESET_COLOR}" >&2
}

log_warn() {
  [[ ${LOG_LEVEL_WARN} -le ${LOG_LEVEL} ]] && echo -e "${COLOR_YELLOW}🟠 $*${RESET_COLOR}" >&2
}

log_error() {
  [[ ${LOG_LEVEL_ERROR} -le ${LOG_LEVEL} ]] && echo -e "${COLOR_RED}🔴 $*${RESET_COLOR}" >&2
}

# Final success message (always displayed)
log_final() {
  echo -e "🚀 $*" >&2
}
